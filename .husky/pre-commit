#!/usr/bin/env sh
# Husky pre-commit hook — Governance validation
# Runs structure validation before allowing commits

echo "🔍 Running structure validation..."

# Run validate-structure.ts with tsx (project uses tsx, not ts-node)
npx tsx scripts/validate-structure.ts --strict
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "🛑 COMMIT REJECTED — structure violations detected."
  echo "   Fix errors above, then retry commit."
  echo "   To bypass (NOT recommended): git commit --no-verify"
  exit 1
fi

echo "✅ Structure validation passed."
