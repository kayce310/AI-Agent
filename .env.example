# KATO AGENT ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# ==============================================
# LLM PROVIDERS
# ==============================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ==============================================
# BRIDGE MODULES
# ==============================================
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
TELEGRAM_BOT_TOKEN=

# ==============================================
# MCP SERVERS
# ==============================================
MCP_SERVER_CONFIG_PATH=./mcp-servers.json

# ==============================================
# AGENT CONFIGURATION
# ==============================================
AGENT_NAME=Kato
AGENT_LOG_LEVEL=info
KNOWLEDGE_BASE_PATH=./knowledge

# ==============================================
# LOCAL LLM MEMORY COMPRESSOR
# ==============================================
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3:8b

# ==============================================
# OBSERVABILITY — Langfuse
# ==============================================
# Get your keys from https://cloud.langfuse.com or self-hosted
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ==============================================
# MODEL GATEWAY — LiteLLM
# ==============================================
# LiteLLM proxy server (100+ LLM providers via OpenAI-compatible API)
# See: https://github.com/BerriAI/litellm
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODELS=
# LITELLM_TIMEOUT=60000

# ==============================================
# 9ROUTER � Local AI Gateway (default)
# ==============================================
# 9router ch?y external t?i localhost:20128
# Kh?i d?ng 9router tru?c khi ch?y Kato
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=9router
AI_MODEL=

