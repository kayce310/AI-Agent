# KATO AGENT ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# ==============================================
# LLM PROVIDERS
# ==============================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ==============================================
# BRIDGE MODULES
# ==============================================
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
TELEGRAM_BOT_TOKEN=

# ==============================================
# MCP SERVERS
# ==============================================
MCP_SERVER_CONFIG_PATH=./mcp-servers.json

# ==============================================
# AGENT CONFIGURATION
# ==============================================
AGENT_NAME=Kato
AGENT_LOG_LEVEL=info
KNOWLEDGE_BASE_PATH=./knowledge

# ==============================================
# LOCAL LLM MEMORY COMPRESSOR
# ==============================================
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3:8b
