# Kato Agent — Environment Configuration
# Copy this file to .env and fill in your values

# Discord Bot Token (from Discord Developer Portal → Bot → Token)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Tavily Search API Key (from https://app.tavily.com)
TAVILY_API_KEY=tvly-...

# Optional: Jina AI API Key (for higher rate limits on fetch_url)
# JINA_API_KEY=your_jina_key_here
