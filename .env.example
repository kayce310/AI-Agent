# Kato Agent — Environment Configuration
# Copy this file to .env and fill in your values

# Discord Bot Token (from Discord Developer Portal → Bot → Token)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Tavily Search API Key (from https://app.tavily.com)
TAVILY_API_KEY=tvly-...

# Optional: Jina AI API Key (for higher rate limits on fetch_url)
# JINA_API_KEY=your_jina_key_here

# Telegram bot config
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram channel IDs where Coral responds to ALL messages
# (no @mention required). Useful for dedicated test channels.
# Example: TELEGRAM_ALWAYS_REPLY_CHANNELS=-1001234567890,-1009876543210
# TELEGRAM_ALWAYS_REPLY_CHANNELS=
