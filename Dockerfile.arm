FROM node:22-alpine

# Build deps + poppler-utils (for pdf-parse native dep)
RUN apk add --no-cache python3 make g++ poppler-utils

WORKDIR /app

# Layer: dependencies (leverages Docker cache)
COPY package*.json ./
RUN npm ci && npm rebuild better-sqlite3 --target_platform=linux --target_arch=arm64

# Layer: source
COPY . .

EXPOSE 8766

CMD ["npm", "start"]
